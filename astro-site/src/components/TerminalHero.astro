<script>
  function initBootSequence() {
    const root = document.getElementById("boot-body");
    if (!root) return;

    const fillEl = root.querySelector("[data-bar-fill]");
    const emptyEl = root.querySelector("[data-bar-empty]");
    const pctEl = root.querySelector("[data-bar-pct]");
    const txEls = Array.from(root.querySelectorAll("[data-tx]"));
    const bootEls = Array.from(root.querySelectorAll("[data-boot-only]"));

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduceMotion || !fillEl || !emptyEl || !pctEl) return;

    const TOTAL_BLOCKS = 20;
    txEls.forEach((el) => el.classList.add("tx-hidden"));

    function revealLines() {
      txEls.forEach((el, i) => {
        setTimeout(() => el.classList.remove("tx-hidden"), i * 160);
      });
    }

    function dismissBootLines() {
      bootEls.forEach((el) => el.classList.add("tx-hidden"));
      setTimeout(() => {
        bootEls.forEach((el) => {
          el.style.display = "none";
        });
        revealLines();
      }, 350);
    }

    let pct = 0;
    const barTimer = setInterval(() => {
      pct = Math.min(100, pct + 4);
      const filled = Math.round((pct / 100) * TOTAL_BLOCKS);
      fillEl.textContent = "█".repeat(filled);
      emptyEl.textContent = "█".repeat(TOTAL_BLOCKS - filled);
      pctEl.textContent = String(pct);
      if (pct >= 100) {
        clearInterval(barTimer);
        setTimeout(dismissBootLines, 300);
      }
    }, 45);
  }

  document.addEventListener("astro:page-load", initBootSequence);
</script>

<style>
  .terminal-hero {
    padding: var(--space-16) 0;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 var(--space-6);
  }
  .eyebrow-line {
    width: 28px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  .hero-left h1 {
    font-size: clamp(2.4rem, 4.5vw, var(--text-5xl));
    font-weight: var(--fw-regular);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-6);
  }
  .word-accent {
    font-weight: var(--fw-bold);
    background: linear-gradient(
      120deg,
      var(--c-green-400),
      var(--c-green-500) 45%,
      var(--c-green-300)
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    color: var(--text-secondary);
    font-size: var(--text-md);
    line-height: 1.75;
    max-width: 42ch;
    margin: 0 0 var(--space-8);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--text-on-accent);
    font-weight: var(--fw-semibold);
    box-shadow: var(--glow-accent);
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .hero-cta:hover {
    background: var(--accent-hover);
    box-shadow: 0 0 24px rgba(79, 180, 24, 0.45);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .hero-cta .arrow {
    transition: transform 0.15s ease;
  }
  .hero-cta:hover .arrow {
    transform: translate(2px, -2px);
  }

  .terminal-window .terminal-title {
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
  }
  .terminal-window .body {
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 2;
    height: 362px;
    overflow: hidden;
  }
  .rl-sys {
    color: var(--text-secondary);
  }
  .rl-white {
    color: var(--text-primary);
    font-weight: var(--fw-medium);
  }
  .rl-green {
    color: var(--accent);
  }
  .rl-empty {
    height: 0.5em;
  }
  .rl-accept {
    color: var(--accent-strong);
    font-weight: var(--fw-bold);
    text-shadow: var(--glow-accent);
  }
  .rl-bar {
    color: var(--text-tertiary);
  }
  .rl-bar [data-bar-fill] {
    color: var(--accent);
  }
  .rl-bar [data-bar-empty] {
    color: var(--c-grey-600);
  }

  [data-tx],
  [data-boot-only] {
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  [data-tx].tx-hidden,
  [data-boot-only].tx-hidden {
    opacity: 0;
    transform: translateY(4px);
  }

  .operator {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--border-subtle);
  }
  .operator-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    box-shadow: var(--glow-accent);
    flex-shrink: 0;
  }
  .operator-name {
    flex: 1;
    font-family: var(--font-mono);
    color: var(--text-primary);
    letter-spacing: 0.05em;
  }
  .operator-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .operator-links a {
    display: inline-flex;
    color: var(--text-tertiary);
    transition: color 0.15s ease;
  }
  .operator-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>
